Project routecost {
  database_type: 'PostgreSQL'
  Note: 'Schema after Flyway migrations V1-V8. All id columns are BIGINT GENERATED BY DEFAULT AS IDENTITY in PostgreSQL (shown with increment in DBML). Expenses have no currency column in the final schema.'
}

TableGroup users_auth {
  users
  refresh_tokens
}

TableGroup vehicles_expenses {
  vehicles
  fuel_entries
  expenses
}

TableGroup reminders_notifications {
  reminders
  reminder_notifications
  user_notifications
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  role varchar(20) [not null, default: 'USER']
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `role IN ('USER', 'ADMIN')` [name: 'chk_users_role']
  }
}

Table vehicles {
  id bigint [pk, increment]
  owner_id bigint [not null]
  make varchar(100) [not null]
  model varchar(100) [not null]
  production_year integer [not null]
  fuel_type varchar(20) [not null]
  current_odometer integer [not null, default: 0]
  purchase_date date [not null]
  purchase_price numeric(12,2) [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    owner_id [name: 'idx_vehicles_owner_id']
    (owner_id, created_at [desc]) [name: 'idx_vehicles_owner_created_at']
  }

  checks {
    `production_year BETWEEN 1886 AND 2100` [name: 'chk_vehicles_production_year']
    `fuel_type IN ('PETROL', 'DIESEL', 'LPG', 'HYBRID', 'ELECTRIC', 'OTHER')` [name: 'chk_vehicles_fuel_type']
    `current_odometer >= 0` [name: 'chk_vehicles_odometer']
    `purchase_price >= 0` [name: 'chk_vehicles_purchase_price']
  }
}

Table fuel_entries {
  id bigint [pk, increment]
  vehicle_id bigint [not null]
  entry_date date [not null]
  odometer integer [not null]
  liters numeric(10,3) [not null]
  total_cost numeric(12,2) [not null]
  full_tank boolean [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (vehicle_id, entry_date, id) [name: 'idx_fuel_entries_vehicle_date_id']
  }

  checks {
    `odometer >= 0` [name: 'chk_fuel_entries_odometer']
    `liters > 0` [name: 'chk_fuel_entries_liters']
    `total_cost > 0` [name: 'chk_fuel_entries_total_cost']
  }
}

Table expenses {
  id bigint [pk, increment]
  vehicle_id bigint [not null]
  expense_date date [not null]
  category varchar(30) [not null]
  amount numeric(12,2) [not null]
  description varchar(1000)
  odometer integer
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (vehicle_id, expense_date [desc], id [desc]) [name: 'idx_expenses_vehicle_date_id']
    (vehicle_id, category, expense_date) [name: 'idx_expenses_vehicle_category_date']
  }

  checks {
    `category IN ('REPAIR', 'PARTS', 'SERVICE', 'INSURANCE', 'TECHNICAL_INSPECTION', 'TIRES', 'CAR_WASH', 'OTHER')` [name: 'chk_expenses_category']
    `amount > 0` [name: 'chk_expenses_amount']
    `odometer IS NULL OR odometer >= 0` [name: 'chk_expenses_odometer']
  }

  Note: 'Final schema after V7 has no currency column.'
}

Table reminders {
  id bigint [pk, increment]
  vehicle_id bigint [not null]
  type varchar(30) [not null]
  title varchar(150) [not null]
  description varchar(1000)
  due_date date [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  odometer integer
  activation_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (vehicle_id, due_date, status) [name: 'idx_reminders_vehicle_due_status']
    (status, due_date) [name: 'idx_reminders_status_due_date']
  }

  checks {
    `type IN ('INSURANCE', 'TECHNICAL_INSPECTION', 'SERVICE', 'OIL_CHANGE', 'TIRES', 'OTHER')` [name: 'chk_reminders_type']
    `status IN ('ACTIVE', 'COMPLETED', 'CANCELLED')` [name: 'chk_reminders_status']
    `odometer IS NULL OR odometer >= 0` [name: 'chk_reminders_odometer']
    `activation_version > 0` [name: 'chk_reminders_activation_version']
  }
}

Table reminder_notifications {
  id bigint [pk, increment]
  reminder_id bigint [not null]
  activation_version integer [not null]
  notification_kind varchar(20) [not null]
  due_date date [not null]
  status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  published_at timestamptz
  processed_at timestamptz

  indexes {
    (reminder_id, activation_version, notification_kind, due_date) [unique, name: 'uq_reminder_notification_generation']
    (status, created_at, id) [name: 'idx_reminder_notifications_pending']
  }

  checks {
    `notification_kind IN ('UPCOMING', 'OVERDUE')` [name: 'chk_reminder_notification_kind']
    `status IN ('PENDING', 'PUBLISHED', 'PROCESSED', 'DISCARDED')` [name: 'chk_reminder_notification_status']
    `activation_version > 0` [name: 'chk_reminder_notification_activation']
  }
}

Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  token_hash varchar(64) [not null, unique]
  family_id uuid [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  revoked_at timestamptz
  replaced_by_hash varchar(64)

  indexes {
    user_id [name: 'idx_refresh_tokens_user_id']
    family_id [name: 'idx_refresh_tokens_family_id']
    expires_at [name: 'idx_refresh_tokens_expires_at']
  }
}

Table user_notifications {
  id bigint [pk, increment]
  reminder_notification_id bigint [not null, unique]
  user_id bigint [not null]
  vehicle_id bigint [not null]
  reminder_id bigint [not null]
  title varchar(180) [not null]
  message varchar(300) [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  read_at timestamptz

  indexes {
    (user_id, created_at [desc], id [desc]) [name: 'idx_user_notifications_owner_created']
  }

  Note: 'SQL also defines partial index idx_user_notifications_unread on (user_id, created_at DESC, id DESC) WHERE read_at IS NULL. It is documented here because DBML index syntax does not represent the SQL predicate.'
}

Ref: vehicles.owner_id > users.id [delete: cascade]
Ref: fuel_entries.vehicle_id > vehicles.id [delete: cascade]
Ref: expenses.vehicle_id > vehicles.id [delete: cascade]
Ref: reminders.vehicle_id > vehicles.id [delete: cascade]
Ref: reminder_notifications.reminder_id > reminders.id [delete: cascade]
Ref: reminder_notifications.id - user_notifications.reminder_notification_id [delete: cascade]
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: user_notifications.user_id > users.id [delete: cascade]
Ref: user_notifications.vehicle_id > vehicles.id [delete: cascade]
Ref: user_notifications.reminder_id > reminders.id [delete: cascade]
